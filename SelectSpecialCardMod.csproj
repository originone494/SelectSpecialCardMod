<Project Sdk="Godot.NET.Sdk/4.5.1">
  <Import Project="Local.Build.props" Condition="Exists('Local.Build.props')" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Sts2Dir Condition="'$(Sts2Dir)' == ''">D:\steam\steamapps\common\Slay the Spire 2</Sts2Dir>
    <GodotExe Condition="'$(GodotExe)' == ''">D:\myProgram\Godot_v4.5.1-stable_mono_win64\Godot_v4.5.1-stable_mono_win64\Godot_v4.5.1-stable_mono_win64.exe</GodotExe>
    <Sts2DataDir>$(Sts2Dir)/data_sts2_windows_x86_64</Sts2DataDir>

    <!-- RitsuLib 新版为多版本 bundle：引用方式由 RitsuLib.References.props 统一提供
         （compat/{版本}/STS2-RitsuLib.dll、STS2-RitsuLib.Runtime.dll + shared 下的三个程序集）。
         compat 下存在多个版本目录时必须显式指定目标版本。 -->
    <RitsuLibRoot Condition="'$(RitsuLibRoot)' == ''">D:/steam/steamapps/workshop/content/2868840/3747602295/</RitsuLibRoot>
    <RitsuLibReferenceTarget>0.111.0</RitsuLibReferenceTarget>
  </PropertyGroup>

  <Import Project="$(RitsuLibRoot)RitsuLib.References.props" />
  <PropertyGroup>
    <PackageDir Condition="'$(PackageDir)' == ''">$(MSBuildProjectDirectory)/artifacts/package</PackageDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PrepareGodotExport)' == 'true'">
    <Reference Update="sts2;0Harmony;STS2-RitsuLib;STS2-RitsuLib.Runtime;STS2-RitsuLib.Shared;STS2-RitsuLib.Ui;STS2-RitsuLib.Settings" Private="True" />
  </ItemGroup>
  <Target Name="PrepareExportReferences">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Rebuild"
             Properties="Configuration=$(Configuration);PrepareGodotExport=true" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Rebuild" Condition="'$(Configuration)' != 'Debug'"
             Properties="Configuration=Debug;PrepareGodotExport=true" />
  </Target>
  <Target Name="PackageMod" DependsOnTargets="Build;PrepareExportReferences">
    <MakeDir Directories="$(PackageDir)" />
    <Delete Files="$(PackageDir)/$(MSBuildProjectName).pck" />
    <Exec Command="&quot;$(GodotExe)&quot; --path &quot;$(ProjectDir)\&quot; --headless --export-pack &quot;Windows Desktop&quot; &quot;$(PackageDir)/$(MSBuildProjectName).pck&quot;"
          EnvironmentVariables="IsInnerGodotExport=true;PrepareGodotExport=true;DOTNET_ROLL_FORWARD=Major;MSBUILDDISABLENODEREUSE=1" />
    <Error Condition="!Exists('$(PackageDir)/$(MSBuildProjectName).pck')" Text="PCK export did not produce the package." />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectName).json" DestinationFolder="$(PackageDir)" />
    <GetFileHash Files="$(PackageDir)/$(MSBuildProjectName).dll;$(PackageDir)/$(MSBuildProjectName).json;$(PackageDir)/$(MSBuildProjectName).pck" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="PackageHashes" />
    </GetFileHash>
    <WriteLinesToFile File="$(PackageDir)/package.sha256" Lines="@(PackageHashes->'%(FileHash) %(Filename)%(Extension)')" Overwrite="true" />
  </Target>
  <Target Name="ExportPck" DependsOnTargets="PackageMod" />
  <Target Name="DeployMod" DependsOnTargets="PackageMod">
    <MakeDir Directories="$(Sts2Dir)/mods/$(MSBuildProjectName)" />
    <Copy SourceFiles="$(PackageDir)/$(MSBuildProjectName).dll;$(PackageDir)/$(MSBuildProjectName).json;$(PackageDir)/$(MSBuildProjectName).pck"
          DestinationFolder="$(Sts2Dir)/mods/$(MSBuildProjectName)" />
  </Target>
</Project>
